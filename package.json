{
  "name": "verbatims",
  "version": "1.40.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "dev": "NUXT_HUB_LOCAL_DB=1 NITRO_PRESET=node-server nuxt dev --port 3002",
    "predev": "node ./scripts/check-local-db.mjs",
    "dev:worker": "node ./scripts/dev-worker.mjs",
    "db:check": "node ./scripts/check-local-db.mjs",
    "db:migrate": "node ./scripts/migrate-local-db.mjs",
    "db:sync-prod": "node ./scripts/sync-prod-to-local.mjs",
    "facebook:token": "node ./scripts/generate-facebook-page-token.mjs",
    "facebook:token:write": "node ./scripts/generate-facebook-page-token.mjs from-user-token --write-env",
    "instagram:token": "node ./scripts/generate-instagram-token.mjs",
    "instagram:token:write": "node ./scripts/generate-instagram-token.mjs from-code --write-env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "NUXT_HUB_LOCAL_DB=1 NITRO_PRESET=node-server nuxt prepare",
    "bump:version": "node ./scripts/bump-version.mjs patch",
    "bump:fix": "node ./scripts/bump-version.mjs fix",
    "bump:minor": "node ./scripts/bump-version.mjs minor",
    "bump:major": "node ./scripts/bump-version.mjs major",
    "version": "node ./scripts/tag-version.mjs",
    "typecheck": "NUXT_HUB_LOCAL_DB=1 NITRO_PRESET=node-server nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@dayflow/blossom-color-picker-vue": "^1.4.0",
    "@libsql/client": "^0.17.4",
    "@noble/hashes": "^2.4.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/test-utils": "4.1.0",
    "@nuxthub/core": "^0.10.10",
    "@nuxtjs/sitemap": "7.6.0",
    "@pinia/nuxt": "0.11.3",
    "@una-ui/nuxt": "^0.66.0",
    "@una-ui/preset": "0.66.0",
    "@unocss/nuxt": "^66.11.0",
    "@verbatims/social-autopost-core": "git+https://github.com/rootasjey/social-autopost-core.git#v0.1.0",
    "@vueuse/nuxt": "14.3.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "0.5.31",
    "nuxt-i18n-micro": "^3.30.1",
    "pinia": "^3.0.4",
    "vue": "3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/openmoji": "^1.2.29",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/solar": "^1.2.13",
    "@iconify-json/tabler": "^1.2.42",
    "@unocss/preset-attributify": "66.11.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "jimp": "^1.6.1",
    "puppeteer": "^24.43.1",
    "typescript": "5.9.3",
    "unocss": "66.11.0",
    "vitest": "^4.1.12",
    "vue-tsc": "3.3.13",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "@unocss/autocomplete": "66.11.0",
    "@unocss/cli": "66.11.0",
    "@unocss/config": "66.11.0",
    "@unocss/core": "66.11.0",
    "@unocss/extractor-arbitrary-variants": "66.11.0",
    "@unocss/inspector": "66.11.0",
    "@unocss/language-server": "66.11.0",
    "@unocss/nuxt": "66.11.0",
    "@unocss/preset-attributify": "66.11.0",
    "@unocss/preset-icons": "66.11.0",
    "@unocss/preset-mini": "66.11.0",
    "@unocss/preset-tagify": "66.11.0",
    "@unocss/preset-typography": "66.11.0",
    "@unocss/preset-uno": "66.11.0",
    "@unocss/preset-web-fonts": "66.11.0",
    "@unocss/preset-wind": "66.11.0",
    "@unocss/preset-wind3": "66.11.0",
    "@unocss/preset-wind4": "66.11.0",
    "@unocss/rollup": "66.11.0",
    "@unocss/rule-utils": "66.11.0",
    "@unocss/transformer-attributify-jsx": "66.11.0",
    "@unocss/transformer-compile-class": "66.11.0",
    "@unocss/transformer-directives": "66.11.0",
    "@unocss/transformer-variant-group": "66.11.0",
    "@unocss/vite": "66.11.0",
    "@unocss/webpack": "66.11.0",
    "unocss": "66.11.0",
    "@vueuse/core": "14.3.0",
    "@vueuse/shared": "14.3.0"
  },
  "trustedDependencies": [
    "@verbatims/social-autopost-core"
  ]
}
